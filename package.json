{
  "name": "@gitlab_group_name/project_name",
  "version": "1.0.0",
  "description": "{PROJECT_DESCRIPTION}",
  "private": true,
  "author": "{AUTHOR_NAME}",
  "homepage": "/",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+{GITLAB_PROJECT_URL}"
  },
  "scripts": {
    "install": "cd client && yarn install && cd ../server && yarn install && cd ../",
    "start": "cd client && yarn start:frontend & cd ../server && yarn start:backend",
    "start:windows": "cd client && yarn start:frontend--windows & cd ../server && yarn start:backend--windows",
    "start:backend-watch": "cd client && yarn start:frontend & cd ../server && yarn start:backend--watch",
    "start:backend-watch--windows": "cd client && yarn start:frontend--windows & cd ../server && yarn start:backend--watch--windows",
    "build": "cd client && rimraf build & react-scripts build",
    "build:win": "cd client && rimraf build && set NODE_ENV=production & set PORT=4000 & react-scripts build",
    "docker:clean": "docker system prune",
    "docker:build": "docker build -t react-pwa-ai:latest .",
    "docker:run": "docker run -d -it --rm -p 8080:8080 react-pwa-ai",
    "docker:compose--local": "docker-compose -f docker-compose.yml up frontend",
    "docker:compose--prod": "docker-compose -f docker-compose.yml up production",
    "test": "react-scripts test",
    "format": "prettier --write .",
    "eject": "react-scripts eject"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "react": "^17.0.2",
    "react-scripts": "^5.0.1",
    "typescript": "^4.7.4"
  },
  "devDependencies": {
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@types/cors": "^2.8.12",
    "@typescript-eslint/eslint-plugin": "5.3.0",
    "@typescript-eslint/eslint-plugin-tslint": "5.3.0",
    "@types/express-fileupload": "^1.4.1",
    "@types/jest": "^28.1.8",
    "@types/lodash": "^4.14.184",
    "@types/pouchdb": "^6.4.0",
    "@types/react-beautiful-dnd": "^13.1.2",
    "eslint": "7.22.0",
    "eslint-config-prettier": "8.8.0",
    "eslint-import-resolver-typescript": "^3.5.5",
    "eslint-plugin-babel": "5.3.1",
    "eslint-plugin-ember": "10.5.9",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-jsdoc": "32.3.0",
    "eslint-plugin-prefer-arrow": "1.2.3",
    "eslint-plugin-react": "7.32.2",
    "eslint-plugin-react-hooks": "4.x",
    "eslint-plugin-simple-import-sort": "10.0.0",
    "sass": "^1.51.0",
    "serve": "^10.1.1",
    "ts-node": "^10.9.1",
    "prettier": "2.3.1"
  },
  "browserslist": [
    "last 1 chrome version",
    "last 1 ChromeAndroid version",
    "last 1 firefox version",
    "last 1 FirefoxAndroid version",
    "last 1 safari version",
    "last 1 edge version"
  ]
}
