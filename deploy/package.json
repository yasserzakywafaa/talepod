  "homepage": "/",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://gitlab.com/yasserzakywafaa/talepod.git"
  },
  "scripts": {
    "start": "yarn install && node server.js",
    "build": "yarn build-copy:server && yarn build-copy:client",
    "build-copy:server": "cd .. && cd server && yarn install --production && yarn build && cp -r ./build/. ../deploy/",
    "build-copy:client": "cd .. && cd client && yarn install --production && yarn build && cp -r ./build/. ../deploy/client",
    "build--windows": "yarn build-copy:client--windows && yarn build-copy:server--windows",
    "build-copy:server--windows": "cd .. && cd server && yarn install && yarn build && cp -r ./build/. ../deploy/",
    "build-copy:client--windows": "cd .. && cd client && yarn install && yarn build && cp -r ./build/. ../deploy/client/"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.591.0",
    "@aws-sdk/credential-provider-node": "3.590.0",
    "@google/generative-ai": "0.6.0",
    "body-parser": "1.20.2",
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "express": "4.18.1",
    "mongoose": "8.4.0",
    "nodemon": "2.0.19",
    "openai": "4.47.1",
    "path": "0.12.7",
    "tslib": "2.6.2",
    "typescript": "5.4.5",
    "@emotion/react": "11.11.4",
    "@emotion/styled": "11.11.5",
    "@mui/icons-material": "5.15.15",
    "@mui/material": "5.15.15",
    "@mui/styles": "5.15.15",
    "@react-oauth/google": "^0.12.1",
    "@tinymce/tinymce-react": "5.0.1",
    "@types/pouchdb": "6.4.0",
    "@types/react": "18.2.25",
    "@types/react-dom": "18.2.25",
    "@types/react-router-dom": "5.3.3",
    "axios": "1.6.8",
    "classnames": "2.5.1",
    "html-loader-react-scripts": "1.2.1",
    "raw-loader": "4.0.2",
    "react": "18.2.0",
    "react-dom": "18.2.0",
