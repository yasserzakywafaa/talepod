{
  "AWSEBDockerrunVersion": "1",
  "Image": {
    "Name": "docker/compose:1.29.2",
    "Update": "true"
  },
  "Volumes": [
    {
      "HostDirectory": "/var/app/deploy",
      "ContainerDirectory": "/var/app/deploy"
    }
  ],
  "EntryPoint": [
    "docker-compose",
    "-f",
    "/var/app/deploy/docker-compose.yml",
    "up"
  ]
}
