{
  "version": 2,
  "buildCommand": "yarn build",
  "builds": [
    {
      "src": "src/server.ts",
      "use": "@vercel/node",
      "config": {
        "distDir": "build"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "build"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}
