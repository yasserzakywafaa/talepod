{
  "name": "@gitlab_group_name/project_name",
  "version": "1.0.0",
  "description": "{PROJECT_DESCRIPTION}",
  "private": true,
  "author": "",
  "type": "module",
  "homepage": "/",
  "license": "MIT",
  "main": "dist/server.js",
  "repository": {
    "type": "git",
    "url": "git+{GITLAB_PROJECT_URL}"
  },
  "scripts": {
    "start": "ts-node src/server.ts",
    "start:backend": "NODE_ENV=development ts-node src/server.ts",
    "start:backend--windows": "set NODE_ENV=development & ts-node src/server.ts",
    "start:backend--watch": "NODE_ENV=development nodemon src/server.ts",
    "start:backend--watch--windows": "set NODE_ENV=development & nodemon src/server.ts",
    "start:prod": "NODE_ENV=production ts-node src/server.ts",
    "start:prod--windows": "set NODE_ENV=production & ts-node src/server.ts",
    "build": "tsc"
  },
  "dependencies": {
    "@google/generative-ai": "0.6.0",
    "body-parser": "^1.20.2",
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "express": "4.18.1",
    "nodemon": "2.0.19",
    "openai": "4.33.0",
    "path": "0.12.7",
    "tslib": "^2.6.2"
  },
  "devDependencies": {
    "@types/cors": "2.8.12",
    "@types/node": "18.19.31",
    "ts-node": "10.9.2",
    "typescript": "5.4.5"
  }
}
