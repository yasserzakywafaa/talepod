# MCP connector for AI tools (server-core createBlogMcp). Connector URL: https://api.talepod.com/mcp/<key>
# One key (at least 32 characters, openssl rand -hex 32) is enough with the SwissLII gateway.
MCP_KEYS=
# How the tools describe the site to the AI (keeps posts on topic)
MCP_SITE_NAME=Talepod
MCP_SITE_ABOUT=an AI app that writes custom, personalised bedtime stories for kids
# Languages posts can be written in, same as the web locales
BLOG_LANGUAGES=en,de,fr,ar
# New blog posts each key may create per 24 hours (default 20)
MCP_DAILY_POSTS=20
# Optional: rebuilds the site when a published post changes
VERCEL_DEPLOY_HOOK_URL=

# Contact form anti-spam (Cloudflare Turnstile). Required in production (the form answers 503 without it);
# elsewhere Turnstile is skipped when empty. Test secret that always passes: 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=
# Per-IP contact limit: max messages per window (default 5 per 10 minutes, and 4x that per day)
CONTACT_RATE_LIMIT_MAX=
CONTACT_RATE_LIMIT_WINDOW_MS=
