# Development
CI=true
PORT=1600
HTTPS=false
BROWSER=none
ESLINT_NO_DEV_ERRORS=true

# Custom app variables (REACT_APP_ prefix is exposed via Vite envPrefix)
REACT_APP_PORT=1600
REACT_APP_SERVER_PORT=16000
REACT_APP_ENV=local
# REACT_APP_ENV=production

# URLs
REACT_APP_DEV_API_URL=https://api-dev.talepod.com
REACT_APP_PROD_API_URL=https://api.talepod.com

# Auth / tracking
REACT_APP_GOOGLE_OAUTH_CLIENT_ID=
REACT_APP_GOOGLE_ANALYTICS_ID=
REACT_APP_GOOGLE_TAG_MANAGER_ID=
