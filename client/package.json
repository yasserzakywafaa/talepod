  "scripts": {
    "start": "vite",
    "start:windows": "set REACT_APP_ENV=local&& vite",
    "start:dev": "REACT_APP_ENV=development vite",
    "start:prod": "serve -l 5000 -s dist",
    "build": "rimraf dist && vite build",
