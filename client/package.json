{
  "name": "@gitlab_group_name/project_name",
  "version": "1.0.0",
  "description": "{PROJECT_DESCRIPTION}",
  "private": true,
  "author": "",
  "homepage": "/",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+{GITLAB_PROJECT_URL}"
  },
  "scripts": {
    "start:frontend": "react-scripts start",
    "start:frontend--disable-reload": "NODE_ENV=development REACT_APP_DISABLE_LIVE_RELOAD=true yarn start:frontend",
    "start:frontend--disable-reload--windows": "set NODE_ENV=development & set REACT_APP_DISABLE_LIVE_RELOAD=true & yarn start:frontend",
    "start:frontend--prod": "serve -l 5000 -s build",
    "build": "cd client && rimraf build & react-scripts build",
    "build:windows": "cd client && rimraf build && set NODE_ENV=production & set PORT=4000 & react-scripts build",
    "docker:clean": "docker system prune",
    "docker:build": "docker build -t react-pwa-ai:latest .",
    "docker:run": "docker run -d -it --rm -p 8080:8080 react-pwa-ai",
    "docker:compose--local": "docker-compose -f docker-compose.yml up frontend",
    "docker:compose--prod": "docker-compose -f docker-compose.yml up production",
    "test": "react-scripts test",
    "eject": "react-scripts eject"
  },
  "dependencies": {
    "@emotion/react": "^11.11.4",
    "@emotion/styled": "^11.11.5",
    "@google/generative-ai": "^0.6.0",
    "@mui/icons-material": "^5.15.15",
    "@mui/material": "^5.15.15",
    "@mui/styles": "^5.15.15",
    "@tinymce/tinymce-react": "^5.0.1",
    "@types/react-dom": "^18.0.6",
    "@types/react-router-dom": "^5.3.3",
    "axios": "^0.21.4",
    "classnames": "^2.3.1",
    "cors": "^2.8.5",
    "html-loader-react-scripts": "^1.2.1",
    "raw-loader": "^4.0.2",
    "react": "^17.0.2",
    "react-beautiful-dnd": "^13.1.0",
    "react-dom": "^17.0.2",
    "react-router-dom": "^5.2.0",
    "react-scripts": "^5.0.1",
    "react-toastify": "^9.0.8",
    "typescript": "^4.7.4"
  },
  "devDependencies": {
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@testing-library/react": "^13.3.0",
    "@types/cors": "^2.8.12",
    "@types/express-fileupload": "^1.4.1",
    "@types/jest": "^28.1.8",
    "@types/lodash": "^4.14.184",
    "@types/react-beautiful-dnd": "^13.1.2",
    "sass": "^1.51.0",
    "serve": "^10.1.1"
  }
}
