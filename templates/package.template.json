{
  "name": "@gitlab_group_name/{project_name}",
  "version": "1.0.0",
  "description": "{PROJECT_DESCRIPTION}",
  "private": true,
  "author": "",
  "type": "module",
  "homepage": "/",
  "license": "MIT",
  "main": "dist/server.js",
  "repository": {
    "type": "git",
    "url": "git+{GITLAB_PROJECT_URL}"
  },
  "scripts": {
    "start": "yarn start:frontend & yarn start:backend",
    "start:no-reload": "yarn start:frontend--disable-reload & yarn start:backend",
    "start:prod": "NODE_ENV=production ts-node server/app.ts",
    "start:prod--win": "set NODE_ENV=production & ts-node server/app.ts",
    "start:frontend": "react-scripts start",
    "start:frontend--prod": "serve -l 5000 -s build",
    "start:backend": "ts-node server/app.ts",
    "start:backend--watch": "nodemon server/app.ts",
    "build:frontend": "rimraf build & react-scripts build",
    "build:backend": "tsc",
    "docker:clean": "docker system prune",
    "docker:build": "docker build -t {project_name}:latest .",
    "docker:run": "docker run -d -it --rm -p 8080:8080 {project_name}",
    "docker:compose--local": "docker-compose -f docker-compose.yml up frontend",
    "docker:compose--prod": "docker-compose -f docker-compose.yml up production",
    "test": "react-scripts test",
    "eject": "react-scripts eject"
  },
  "dependencies": {
    "@emotion/react": "11.11.4",
    "@emotion/styled": "11.11.5",
    "@mui/icons-material": "5.15.15",
    "@mui/material": "5.15.15",
    "@mui/styles": "5.15.15",
    "@google/generative-ai": "0.6.0",
    "@tinymce/tinymce-react": "5.0.1",
    "@types/pouchdb": "6.4.0",
    "@types/react": "18.2.25",
    "@types/react-dom": "18.2.25",
    "@types/react-router-dom": "5.3.3",
    "axios": "0.21.4",
    "body-parser": "^1.20.2",
    "classnames": "2.3.1",
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "express": "4.18.1",
    "html-loader-react-scripts": "1.2.1",
    "nodemon": "2.0.19",
    "openai": "4.33.0",
    "path": "0.12.7",
    "raw-loader": "4.0.2",
    "react": "18.1.0",
    "react-dom": "18.1.0",
    "react-router-dom": "6.22.3",
    "react-toastify": "10.0.5",
    "react-scripts": "5.0.1",
    "tslib": "^2.6.2"
  },
  "devDependencies": {
    "@types/cors": "2.8.12",
    "@types/express": "^4.17.21",
    "@types/node": "18.19.31",
    "sass": "1.75.0",
    "serve": "14.2.1",
    "ts-node": "10.9.2",
    "typescript": "5.4.5"
  }
}
