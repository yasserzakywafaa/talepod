# App tier: local | dev | prod  (EXPO_PUBLIC_ENV)
# Expo inlines EXPO_PUBLIC_* when you bundle (yarn start, eas update, eas build).

# --- local: Mac + Expo Go QR (never set "local" on EAS) ---
EXPO_PUBLIC_ENV=local
EXPO_PUBLIC_LOCAL_API_URL=http://192.168.1.141:16001
# EXPO_PUBLIC_SERVER_PORT=16001

# --- dev / prod API hosts (set on EAS for Expo Go updates; optional in .env for testing) ---
EXPO_PUBLIC_DEV_API_URL=https://api-dev.talepod.com
EXPO_PUBLIC_PROD_API_URL=https://api.talepod.com
EXPO_PUBLIC_MOBILE_OAUTH_SCHEME=talepod

# Optional: after `eas init`, set EAS_PROJECT_ID in app.config / EAS env
