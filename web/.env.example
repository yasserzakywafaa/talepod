# Development
CI=true
PORT=1600
HTTPS=false
BROWSER=none
ESLINT_NO_DEV_ERRORS=true

# Custom app variables (REACT_APP_ prefix is exposed via Vite envPrefix)
REACT_APP_PORT=1600
REACT_APP_SERVER_PORT=16000
REACT_APP_ENV=local
# REACT_APP_ENV=production

# URLs
REACT_APP_DEV_API_URL=https://api-dev.talepod.com
REACT_APP_PROD_API_URL=https://api.talepod.com

# Contact form anti-spam: Cloudflare Turnstile site key (public). Leave empty locally;
# test key that always passes: 1x00000000000000000000AA
REACT_APP_TURNSTILE_SITE_KEY=

# Auth / tracking
REACT_APP_GOOGLE_OAUTH_CLIENT_ID=
REACT_APP_GOOGLE_ANALYTICS_ID=

# Vercel preview deployments (must match PREVIEW_SECRET on the API server)
REACT_APP_PREVIEW_SECRET=
